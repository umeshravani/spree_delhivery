<% is_order_scoped = params[:order_id].present? %>
<% order = @order || (defined?(parent_object) ? parent_object : nil) || (is_order_scoped ? Spree::Order.find_by(number: params[:order_id]) : nil) %>
<% return_collection = is_order_scoped ? @return_authorizations : @collection %>

<% content_for :page_title do %>
  <%= Spree.t(:return_authorizations) %>
<% end %>

<%# --- ACTION PATH A: GLOBAL SEARCH MANAGEMENT DASHBOARD WORKSPACE --- %>
<% unless is_order_scoped %>
  <turbo-frame data-turbo-action="advance" id="return_authorizations">
    <div class="card-lg" data-controller="table" data-table-url-value="/admin/return_authorizations">
      <div class="p-2 border-b border-gray-200">
        <div class="flex flex-col lg:flex-row gap-3 items-start lg:items-center justify-between">
          <div class="flex gap-2 items-center flex-wrap">
            <form class="spree/return_authorization_search" id="spree/return_authorization_search" data-turbo-frame="return_authorizations" data-turbo-action="advance" data-controller="auto-submit search-clear" data-auto-submit-delay-value="300" action="/admin/return_authorizations" accept-charset="UTF-8" method="get">
              <div class="form-input flex items-center py-0 pr-1 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-blue-500 lg:w-[300px] me-auto h-[2rem] transition-all duration-100 ease-in-out">
                <i class="ti ti-search mr-4 text-gray-600 shrink-0"></i>
                <input type="search" name="q[number_cont]" id="return_authorizations-table-search-input" class="outline-none border-0 h-full focus:border-0 focus:ring-0 p-0 text-base w-full" placeholder="Search Return Authorizations" data-turbo-permanent="true" data-action="input->auto-submit#submit input->search-clear#toggleClearButton search->auto-submit#submit" data-search-clear-target="input" value="<%= params.dig(:q, :number_cont) %>">
                <button type="button" class="hidden p-1 text-gray-400 hover:text-gray-600 shrink-0" data-search-clear-target="clear" data-action="search-clear#clear">
                  <i class="ti ti-x w-4 h-4"></i>
                </button>
              </div>
            </form>
          </div>

          <div class="flex gap-2 items-center">
            <%# Native Filter Drawer Component %>
            <div data-controller="dialog" class="h-full">
              <button type="button" class="btn btn-make btn-light btn-sm" data-action="dialog#open">
                <i class="ti ti-filter"></i> <span>Filters</span>
              </button>
              <dialog class="drawer" data-dialog-target="dialog" id="query-builder-drawer-return_authorizations">
                <div class="drawer-header"><h5 class="drawer-title">Filter Builder</h5><button name="button" type="button" class="btn-close" data-action="dialog#close" data-dismiss="dialog"></button></div>
                <form data-turbo-frame="return_authorizations" data-turbo-action="advance" class="grow flex flex-col justify-between" action="/admin/return_authorizations" accept-charset="UTF-8" method="get">
                  <div class="drawer-body">
                    <div class="text-sm text-gray-500 italic mb-4">Use standard criteria options to filter returns dynamically.</div>
                  </div>
                  <div class="drawer-footer">
                    <button name="button" type="button" class="btn btn-light" data-action="dialog#close" data-dismiss="dialog">Discard</button>
                    <input type="submit" value="Apply Filters" class="btn btn-primary cursor-pointer">
                  </div>
                </form>
              </dialog>
            </div>

            <%# Sorting Options Component %>
            <div class="dropdown" data-controller="dropdown" data-dropdown-placement-value="bottom-start" data-dropdown-portal-value="false">
              <button name="button" type="button" class="btn btn-light btn-sm" data-action="dropdown#toggle click@window->dropdown#hide" data-dropdown-target="toggle">
                <i class="ti ti-sort-descending"></i><span>Sort by</span><i class="ti ti-chevron-down"></i>
              </button>
              <div class="dropdown-container hidden min-w-[200px]" data-dropdown-target="menu">
                <div class="dropdown-header">Sort by</div>
                <a class="dropdown-item flex items-center justify-between" data-turbo-action="advance" href="/admin/return_authorizations?q%5Bs%5D=number+desc"><span>Number</span></a>
                <a class="dropdown-item flex items-center justify-between" data-turbo-action="advance" href="/admin/return_authorizations?q%5Bs%5D=created_at+desc"><span>Created at</span></a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <% if return_collection && return_collection.any? %>
        <div class="overflow-x-auto">
          <table class="table mb-0">
            <thead>
              <tr>
                <th><%= Spree.t(:number) %></th>
                <th>Order Target</th>
                <th><%= Spree.t(:state) %></th>
                <th><%= Spree.t(:amount) %></th>
                <th><%= Spree.t(:created_at) %></th>
                <th>Delhivery Tracking Status</th>
                <th class="actions"></th>
              </tr>
            </thead>
            <tbody>
              <% return_collection.each do |return_authorization| %>
                <tr id="<%= dom_id(return_authorization) %>" class="align-middle">
                  <td class="font-mono font-medium text-gray-900"><%= return_authorization.number %></td>
                  <td class="font-medium">
                    <%= link_to return_authorization.order.number, spree.edit_admin_order_path(return_authorization.order), class: "text-blue-600 hover:underline", data: { turbo: false } %>
                  </td>
                  <td><span class="badge badge-<%= return_authorization.state %>"><%= Spree.t("return_authorization_states.#{return_authorization.state}") %></span></td>
                  <td class="font-medium"><%= return_authorization.display_amount.to_html %></td>
                  <td class="text-sm text-gray-500"><%= pretty_time(return_authorization.created_at) %></td>
                  <td>
                    <% if return_authorization.respond_to?(:delhivery_waybill) && return_authorization.delhivery_waybill.present? %>
                      <span class="badge badge-success font-mono" style="background-color: #28a745; color: white;"><i class="ti ti-check"></i> <%= return_authorization.delhivery_waybill %></span>
                    <% else %>
                      <span class="text-xs text-gray-400 italic">No pickup scheduled</span>
                    <% end %>
                  </td>
                  <td class="actions text-right">
                    <%= link_to_edit(return_authorization, no_text: true, class: 'btn btn-light btn-sm') if can?(:edit, return_authorization) %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <div class="text-gray-600 p-12 flex items-center w-full justify-center flex-col gap-4">
          <i class="ti ti-map-search opacity-50 text-4xl"></i>
          <p>No Return authorization found</p>
        </div>
      <% end %>
    </div>
  </turbo-frame>
<% end %>

<%# --- ACTION PATH B: PER-ORDER DETAIL SUITE WORKSPACE --- %>
<% if is_order_scoped %>
  <% content_for :page_actions do %>
    <% if order && order.shipments.any?(&:shipped?) %>
      <%= button_link_to Spree.t(:new_return_authorization), new_admin_order_return_authorization_url(order), class: "btn-success", icon: 'add', id: 'admin_new_return_authorization' %>
    <% end %>
  <% end %>

  <% if return_collection && return_collection.any? %>
    <div class="card shadow-sm border border-gray-200 rounded-md overflow-hidden mb-6">
      <table class="table mb-0">
        <thead>
          <tr data-hook="return_authorizations_header">
            <th><%= Spree.t(:number) %></th>
            <th><%= Spree.t(:state) %></th>
            <th><%= Spree.t(:amount) %></th>
            <th><%= Spree.t(:created_at) %></th>
            <th>Delhivery Return</th> 
            <th class="actions"></th>
          </tr>
        </thead>
        <tbody>
          <% return_collection.each do |return_authorization| %>
            <tr id="<%= dom_id(return_authorization) %>" data-hook="return_authorization_row" class="align-middle">
              <td class="font-mono font-medium text-gray-900"><%= return_authorization.number %></td>
              <td>
                <span class="badge badge-<%= return_authorization.state %>">
                  <%= Spree.t("return_authorization_states.#{return_authorization.state}") %>
                </span>
              </td>
              <td class="font-medium"><%= return_authorization.display_amount.to_html %></td>
              <td class="text-muted text-sm"><%= pretty_time(return_authorization.created_at) %></td>
              
              <td>
                <% if return_authorization.respond_to?(:delhivery_waybill) && return_authorization.delhivery_waybill.present? %>
                  <span class="badge badge-success flex items-center gap-1 w-max font-mono" style="background-color: #28a745; color: white;">
                    <i class="ti ti-check"></i> <%= return_authorization.delhivery_waybill %>
                  </span>
                <% else %>
                  <button type="button" class="btn btn-sm btn-outline-primary flex items-center gap-1" onclick="document.getElementById('rvpModal-<%= return_authorization.id %>').showModal()">
                    <i class="ti ti-truck"></i> Schedule Pickup
                  </button>

                  <dialog id="rvpModal-<%= return_authorization.id %>" class="dialog">
                    <div>
                      <div class="dialog-header">
                        <h5 class="dialog-title font-bold flex items-center gap-1.5"><i class="ti ti-truck" style="font-size: 1.2rem;"></i> Schedule Reverse Pickup</h5>
                        <button type="button" class="btn-close" onclick="document.getElementById('rvpModal-<%= return_authorization.id %>').close()"></button>
                      </div>
                      <%= form_with url: spree.delhivery_create_pickup_admin_return_authorization_path(return_authorization), method: :post, data: { turbo: false } do |f| %>
                        <div class="dialog-body text-left">
                          <div class="alert alert-info mb-4">
                            <div>
                              <h5 class="font-bold mb-1" style="font-size: 0.9rem;"><i class="ti ti-building mr-1"></i> Destination Hub</h5>
                              <%= return_authorization.stock_location.name %>
                            </div>
                          </div>
                          <h6 class="text-sm font-semibold text-gray-900 border-b pb-1.5 mb-3">Parametric QC Details</h6>
                          <div class="grid grid-cols-2 gap-4 mb-4">
                            <div class="form-group mb-0">
                              <label class="font-medium text-xs text-gray-700 mb-1 block">Brand Name *</label>
                              <%= f.text_field :brand, value: current_store.name, class: "form-input w-full", required: true %>
                            </div>
                            <div class="form-group mb-0">
                              <label class="font-medium text-xs text-gray-700 mb-1 block">Product Category *</label>
                              <%= f.text_field :category, value: "General", class: "form-input w-full", required: true %>
                            </div>
                          </div>
                          <div class="border rounded-md bg-gray-50 p-3 mb-4">
                            <label class="font-semibold text-xs text-gray-800 mb-2 block">Items ready for pickup:</label>
                            <div class="space-y-1.5 max-h-32 overflow-y-auto">
                              <% return_authorization.return_items.each do |item| %>
                                <div class="flex items-center justify-between text-xs bg-white border border-gray-200 px-2 py-1.5 rounded">
                                  <span class="truncate pr-4 text-gray-700 font-medium"><%= item.inventory_unit.variant.name %></span>
                                  <span class="badge badge-light border text-dark font-mono">Qty: 1</span>
                                </div>
                              <% end %>
                            </div>
                          </div>
                          <div class="flex items-start gap-2 pt-2 border-t">
                            <input type="checkbox" class="form-checkbox text-primary rounded mt-0.5" id="confirmCheck-<%= return_authorization.id %>" required>
                            <label class="text-xs text-gray-600" for="confirmCheck-<%= return_authorization.id %>">I verify metrics match box profile requirements.</label>
                          </div>
                        </div>
                        <div class="dialog-footer">
                          <button type="button" class="btn btn-light" onclick="document.getElementById('rvpModal-<%= return_authorization.id %>').close()">Cancel</button>
                          <button type="submit" class="btn btn-primary">Confirm Pickup</button>
                        </div>
                      <% end %>
                    </div>
                  </dialog>
                <% end %>
              </td>
              
              <td class="actions text-right">
                <div class="flex items-center justify-end gap-1.5">
                  <%= link_to_edit(return_authorization, no_text: true, class: 'btn btn-light btn-sm') if can?(:edit, return_authorization) %>
                  <% if can?(:delete, return_authorization) && order %>
                    <%= button_to spree.cancel_admin_order_return_authorization_path(order, return_authorization), method: :put, data: { confirm: Spree.t(:are_you_sure) }, class: 'btn btn-light btn-sm text-red-500' do %>
                      <i class="ti ti-x"></i>
                    <% end %>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <div class="alert alert-info no-objects-found m-0">
      <%= Spree.t(:no_resource_found, resource: Spree::ReturnAuthorization.model_name.human) %>,
      <% if order %>
        <%= link_to Spree.t(:add_one), new_admin_order_return_authorization_url(order), class: "font-semibold underline" %>!
      <% end %>
    </div>
  <% end %>
<% end %>
